# Copy to .env and replace the password before the first database start.
POSTGRES_USER=resume_app
POSTGRES_DB=resume_rag
POSTGRES_PASSWORD=replace-with-a-local-password
PGHOST=127.0.0.1
PGPORT=5437
# Optional: DATABASE_URL overrides the connection settings above.
# DATABASE_URL=postgresql://resume_app:YOUR_PASSWORD@127.0.0.1:5437/resume_rag
# RESUME_COLLECTION=resume_rag_v1
# OLLAMA_BASE_URL=http://localhost:11434
# Optional retrieval settings. Restart the engine after changing them.
# BM25_K1=1.2
# BM25_B=0.75
# RRF_K=60
