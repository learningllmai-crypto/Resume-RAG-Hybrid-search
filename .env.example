# Copy to .env and replace the password before the first database start.
POSTGRES_USER=resume_app
POSTGRES_DB=resume_rag
POSTGRES_PASSWORD=replace-with-a-local-password
PGHOST=127.0.0.1
PGPORT=5437
# Optional: DATABASE_URL overrides the connection settings above.
# DATABASE_URL=postgresql://resume_app:YOUR_PASSWORD@127.0.0.1:5437/resume_rag
# RESUME_COLLECTION=resume_rag_v1
# OLLAMA_BASE_URL=http://localhost:11434

# Chat model settings. Uncomment one provider setup, then restart Resume Desk.
# CHAT_PROVIDER=ollama
# CHAT_MODEL=llama3.2:3b

# For OpenAI or a compatible chat API, use these settings instead.
# CHAT_PROVIDER=openai
# CHAT_MODEL=gpt-4.1-mini
# CHAT_API_KEY=your-provider-key
# CHAT_API_BASE_URL=https://api.openai.com/v1

# Local search embeddings. Changing this model requires a new index.
# EMBED_MODEL=nomic-embed-text

# Optional retrieval settings. Restart the engine after changing them.
# BM25_K1=1.2
# BM25_B=0.75
# RRF_K=60
